{
  "name": "halation-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "pnpm --filter @halation/forge run build && pnpm -r --filter './packages/*' run build",
    "test": "pnpm -r run test",
    "dev": "pnpm --filter @halation/docs run dev",
    "build:docs": "pnpm --filter @halation/docs run build",
    "lint": "node packages/cli/bin/halation.js lint apps/docs/src packages/react/src",
    "deploy:docs": "pnpm build && pnpm --filter @halation/docs run deploy"
  },
  "devDependencies": {
    "typescript": "~6.0.2"
  }
}
