// The docs site: static assets on Cloudflare, served at halation.mandip.dev.
{
  "name": "halation-docs",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "observability": { "enabled": false },
  "routes": [{ "pattern": "halation.mandip.dev", "custom_domain": true }]
}
