{
  "name": "@halation/cli",
  "version": "0.2.1",
  "description": "Halation's command line: lint source against the rulebook, check a rendered page, and set a project up for agents.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "halation": "./bin/halation.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "kit"
  ],
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\""
  },
  "dependencies": {
    "@halation/core": "workspace:*"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mandipadk/halation.git",
    "directory": "packages/cli"
  },
  "homepage": "https://halation.mandip.dev",
  "bugs": {
    "url": "https://github.com/mandipadk/halation/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
